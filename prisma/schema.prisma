generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  fullName       String   @default("")
  passwordHash   String
  role           String
  isBuiltinAdmin Boolean  @default(false)
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime @updatedAt
  updatedBy      String?
  deletedAt      DateTime?
  deletedBy      String?
  records        VehicleUseRecord[]
  sessions       Session[]
  operationLogs  OperationLog[]

  @@index([deletedAt])
}

model Vehicle {
  id          String   @id @default(cuid())
  vehicleCode String   @unique
  plateNumber String   @unique
  brandModel  String
  status      String   @default("available")
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  deletedAt   DateTime?
  deletedBy   String?
  records     VehicleUseRecord[]

  @@index([deletedAt])
}

model VehicleUseRecord {
  id                       String   @id @default(cuid())
  vehicleId                String
  userId                   String
  businessDate             String
  departureTime            String
  returnTime               String
  reason                   String
  route                    String
  startMileage             Float
  endMileage               Float
  distance                 Float
  isCrossDay               Boolean  @default(false)
  fuelFee                  String?
  fuelVolume               String?
  driverName               String   @default("")
  driverSignature          String
  driverSignatureImage      String?  @db.MediumText
  driverSignaturePdfImage   String?  @db.MediumText
  remark                   String?
  createdAt                DateTime @default(now())
  createdBy                String?
  updatedAt                DateTime @updatedAt
  updatedBy                String?
  deletedAt                DateTime?
  deletedBy                String?
  vehicle                  Vehicle  @relation(fields: [vehicleId], references: [id])
  user                     User     @relation(fields: [userId], references: [id])

  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  loginAt      DateTime @default(now())
  expiredAt    DateTime
  logoutAt     DateTime?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([expiredAt])
}

model OperationLog {
  id             String   @id @default(cuid())
  module         String
  bizType        String
  bizId          String?
  action         String
  operatorUserId String?
  requestPath    String?
  requestMethod  String?
  requestIp      String?
  userAgent      String?
  beforeData     Json?
  afterData      Json?
  resultStatus   String
  errorMessage   String?
  operatedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  operator       User?    @relation(fields: [operatorUserId], references: [id])

  @@index([bizType, bizId])
  @@index([operatorUserId, operatedAt])
  @@index([module, operatedAt])
}
